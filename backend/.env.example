# Get a free API key/token at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_v3_api_key_here

PORT=5000
NODE_ENV=development

# Comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# How long (ms) to cache TMDB responses in memory
CACHE_TTL_MS=300000

# SQLite file location (relative to backend/)
DB_PATH=./data/wishlist.db
